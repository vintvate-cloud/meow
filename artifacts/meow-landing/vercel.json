{
  "rewrites": [
    {
      "source": "/e/(?<id>[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|whatsapp|facebook|twitter|linkedin|skype|slack|telegram|discord|applebot).*"
        }
      ],
      "destination": "/api/og?id=$id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
